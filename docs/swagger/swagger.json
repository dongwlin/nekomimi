{
    "swagger": "2.0",
    "info": {
        "description": "API for token-based auth bootstrap and verification.",
        "title": "Nekomimi API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Validate the single passphrase and issue PASETO tokens.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Exchange passphrase for access/refresh token pair",
                "operationId": "authLogin",
                "parameters": [
                    {
                        "description": "Passphrase",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.tokenResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    }
                }
            }
        },
        "/auth/passphrase/rotate": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Rotate passphrase with current passphrase and revoke existing sessions immediately.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Rotate system passphrase",
                "operationId": "authPassphraseRotate",
                "parameters": [
                    {
                        "description": "Current and new passphrase",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.rotatePassphraseRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.okResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "description": "Rotate refresh token and issue a new token pair.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh access token with refresh token",
                "operationId": "authRefresh",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.refreshRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.tokenResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    }
                }
            }
        },
        "/auth/verify": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Check whether the supplied Bearer access token is valid.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Verify access token",
                "operationId": "authVerify",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.verifyResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpapi.verifyResponse"
                        }
                    }
                }
            }
        },
        "/dashboard/overview": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns runtime status, daily/total KPIs, type distribution, and 24-hour trend.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dashboard"
                ],
                "summary": "Get dashboard overview",
                "operationId": "dashboardOverview",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/metrics.Overview"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "httpapi.loginRequest": {
            "type": "object",
            "required": [
                "passphrase"
            ],
            "properties": {
                "passphrase": {
                    "type": "string"
                }
            }
        },
        "httpapi.okResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean"
                }
            }
        },
        "httpapi.refreshRequest": {
            "type": "object",
            "required": [
                "refresh_token"
            ],
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "httpapi.rotatePassphraseRequest": {
            "type": "object",
            "required": [
                "current_passphrase",
                "new_passphrase"
            ],
            "properties": {
                "current_passphrase": {
                    "type": "string"
                },
                "new_passphrase": {
                    "type": "string"
                }
            }
        },
        "httpapi.tokenResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "refresh_expires_in": {
                    "type": "integer"
                },
                "refresh_token": {
                    "type": "string"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "httpapi.verifyResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "ok": {
                    "type": "boolean"
                }
            }
        },
        "metrics.Overview": {
            "type": "object",
            "properties": {
                "generated_at": {
                    "type": "string"
                },
                "hourly_trend": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/metrics.OverviewHourly"
                    }
                },
                "kpi": {
                    "$ref": "#/definitions/metrics.OverviewKPI"
                },
                "runtime": {
                    "$ref": "#/definitions/metrics.OverviewRuntime"
                },
                "timezone": {
                    "type": "string"
                },
                "today_failed_types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/metrics.OverviewTypeItem"
                    }
                },
                "today_inbound_types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/metrics.OverviewTypeItem"
                    }
                },
                "today_outbound_types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/metrics.OverviewTypeItem"
                    }
                }
            }
        },
        "metrics.OverviewHourly": {
            "type": "object",
            "properties": {
                "failed": {
                    "type": "integer"
                },
                "hour": {
                    "type": "string"
                },
                "received": {
                    "type": "integer"
                },
                "sent": {
                    "type": "integer"
                }
            }
        },
        "metrics.OverviewKPI": {
            "type": "object",
            "properties": {
                "last_failed_at": {
                    "type": "string"
                },
                "last_received_at": {
                    "type": "string"
                },
                "last_sent_at": {
                    "type": "string"
                },
                "llm_enabled": {
                    "type": "boolean"
                },
                "llm_model": {
                    "type": "string"
                },
                "llm_provider": {
                    "type": "string"
                },
                "today_active_sessions": {
                    "type": "integer"
                },
                "today_failed_total": {
                    "type": "integer"
                },
                "today_received_total": {
                    "type": "integer"
                },
                "today_sent_total": {
                    "type": "integer"
                },
                "total_failed_total": {
                    "type": "integer"
                },
                "total_received_total": {
                    "type": "integer"
                },
                "total_sent_total": {
                    "type": "integer"
                }
            }
        },
        "metrics.OverviewRuntime": {
            "type": "object",
            "properties": {
                "bot_connected_at": {
                    "type": "string"
                },
                "bot_started_at": {
                    "type": "string"
                },
                "bot_uptime_seconds": {
                    "type": "integer"
                },
                "process_started_at": {
                    "type": "string"
                },
                "uptime_seconds": {
                    "type": "integer"
                }
            }
        },
        "metrics.OverviewTypeItem": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "ratio": {
                    "type": "number"
                },
                "type": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}